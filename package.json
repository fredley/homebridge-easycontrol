    "login": "tsx scripts/login.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "homebridge": "^2.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  }
