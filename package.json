{
  "name": "homebridge-easycontrol",
  "displayName": "Bosch EasyControl (CT200)",
  "version": "0.1.2",
  "description": "Homebridge plugin for Bosch EasyControl CT200 thermostats via the HomeCom (POINTT) cloud API",
  "license": "MIT",
  "author": "Tom White",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredley/homebridge-easycontrol.git"
  },
  "bugs": {
    "url": "https://github.com/fredley/homebridge-easycontrol/issues"
  },
  "homepage": "https://github.com/fredley/homebridge-easycontrol#readme",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0 || ^26.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "bosch",
    "ct200",
    "easycontrol",
    "homecom"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
